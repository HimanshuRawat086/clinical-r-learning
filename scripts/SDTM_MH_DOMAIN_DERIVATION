#--------------------------------------------------
# Step 1: Environment Setup
#--------------------------------------------------
rm(list=ls())

#--------------------------------------------------
# Step 2: Load Libraries
#--------------------------------------------------
library(haven)
library(dplyr)
library(tidyr)
library(lubridate)
library(stringr)

#--------------------------------------------------
# Step 3: Define Paths
#--------------------------------------------------
raw_path <- "/Users/HimanshuRawat/R_training/Project/RAW/"

sdtm_path <- "/Users/HimanshuRawat/R_training/Project/SDTM/"

#--------------------------------------------------
# Step 4: Read Input Data
#--------------------------------------------------
mh <- read_sas(paste0(raw_path, "mh.sas7bdat"))

dm <- read_sas(paste0(sdtm_path, "dm.sas7bdat"))

se <- read_sas(paste0(sdtm_path, "se.sas7bdat"))

#--------------------------------------------------
# Step 5: Derive MH Domain
#--------------------------------------------------
mh1 <- mh %>%
  filter(MHTERM != "") %>%
  mutate(
    STUDYID = "AA-2020-06",
    
    DOMAIN = "MH",
    
    SITEID = SITENUM,
    
    SUBJID = str_sub(SUBNUM, start = 4),
    
    USUBJID = paste0(STUDYID, "-", SITEID, SUBJID),
    
    MHCAT = "MEDICAL HISTORY",
    
    MHSTDTC = str_replace_all(MHSTDAT, "-UNK", ""),
    
    MHENDTC = str_replace_all(MHENDAT, "-UNK", ""),
    
    MHENRF = case_when(
      MHONGO == "X" ~ "ONGOING",
      MHONGO != "X" ~ "BEFORE"
    ),
    
    MHTERM = str_to_upper(MHTERM),
    
    MHDECOD = PT_TERM
  ) %>%
  arrange(USUBJID, MHSTDTC, MHENDTC, MHTERM) %>%
  group_by(USUBJID) %>%
  mutate(MHSEQ = row_number())

#--------------------------------------------------
# Step 6: Treatment Start Date
#--------------------------------------------------
dm1 <- dm %>%
  mutate(TRTSDT = as.Date(RFSTDTC)) %>%
  select(USUBJID, TRTSDT)

#--------------------------------------------------
# Step 7: Study Day Derivation
#--------------------------------------------------
mh_fin1 <- inner_join(mh1, dm1, by = "USUBJID") %>%
  mutate(
    ASTDT = ymd(MHSTDTC),
    
    AENDT = ymd(MHENDTC),
    
    MHSTDY = ifelse(
      !is.na(ASTDT) < !is.na(TRTSDT),
      ASTDT - TRTSDT,
      ASTDT - TRTSDT + 1
    ),
    
    MHENDY = ifelse(
      !is.na(AENDT) < !is.na(TRTSDT),
      AENDT - TRTSDT,
      AENDT - TRTSDT + 1
    )
  )

#--------------------------------------------------
# Step 8: Process Subject Elements
#--------------------------------------------------
se1 <- se %>%
  mutate(
    sesdate = as.Date(SESTDTC),
    
    seedate = as.Date(SEENDTC)
  ) %>%
  pivot_wider(
    id_cols = "USUBJID",
    
    names_from = "ETCD",
    
    values_from = c("sesdate","seedate")
  )

#--------------------------------------------------
# Step 9: Epoch Assignment
#--------------------------------------------------
fin <- inner_join(mh_fin1, se1, by = "USUBJID") %>%
  mutate(
    EPOCH = case_when(
      
      sesdate_SCRN <= ASTDT &
        ASTDT >= seedate_SCRN ~ "SCREENING",
      
      sesdate_TRT <= ASTDT &
        ASTDT >= seedate_TRT ~ "TREATMENT",
      
      sesdate_FU <= ASTDT &
        ASTDT >= seedate_FU ~ "FOLLOW-UP"
    )
  ) %>%
  select(
    STUDYID,
    DOMAIN,
    USUBJID,
    MHSEQ,
    MHTERM,
    MHDECOD,
    MHSTDTC,
    MHENDTC,
    MHSTDY,
    MHENDY,
    EPOCH
  )
